---
import BaseLayout from "@layouts/BaseLayout.astro";
import { tr } from "@i18n/translations";
import { resolveZoneLang } from "@lib/zone";
const { zone, lang } = resolveZoneLang(Astro.url.pathname);
---

<BaseLayout title="ARMD Group - L'intelligence depuis l'Afrique">
  <section class="mx-auto max-w-3xl px-6 py-24">
    <p class="text-xs uppercase tracking-widest opacity-60">{zone} · {lang}</p>
    <h1 class="mt-4 text-4xl font-semibold leading-tight md:text-5xl">
      {tr("home.placeholder.title", zone, lang)}
    </h1>
    <p class="mt-6 max-w-2xl text-base opacity-80">
      {tr("home.placeholder.body", zone, lang)}
    </p>
  </section>
</BaseLayout>
